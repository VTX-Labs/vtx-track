{
  "name": "@vtx-track/tray",
  "version": "0.1.0",
  "description": "Native system-tray companion for vtx-track — live status, pause/resume, open dashboard, quit. Talks to the local daemon over its localhost API.",
  "keywords": ["vtx-track", "vtx-labs", "tray", "systray", "menu-bar"],
  "homepage": "https://github.com/VTX-Labs/vtx-track/tree/main/packages/tray#readme",
  "bugs": "https://github.com/VTX-Labs/vtx-track/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VTX-Labs/vtx-track.git",
    "directory": "packages/tray"
  },
  "license": "MIT",
  "author": "VTX Labs (https://vtxlabs.dev)",
  "type": "module",
  "bin": {
    "vtx-track-tray": "dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "icons", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@vtx-track/core": "workspace:*",
    "@vtx-track/protocol": "workspace:*",
    "systray2": "2.1.4"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@10.6.5"
}
