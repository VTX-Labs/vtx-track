{
  "name": "@vtx-track/dashboard",
  "version": "0.1.0",
  "description": "Minimal, no-framework localhost web dashboard for the vtx-track time tracker. Vanilla TypeScript plus uPlot, served by the daemon. Local-first, zero cloud.",
  "keywords": ["vtx-track", "vtx-labs", "dashboard", "time-tracking", "uplot", "local-first"],
  "homepage": "https://github.com/VTX-Labs/vtx-track/tree/main/packages/dashboard#readme",
  "bugs": "https://github.com/VTX-Labs/vtx-track/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VTX-Labs/vtx-track.git",
    "directory": "packages/dashboard"
  },
  "license": "MIT",
  "author": "VTX Labs (https://vtxlabs.dev)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsup && node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vtx-track/protocol": "workspace:*",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "esbuild": "^0.28.1",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@10.6.5"
}
