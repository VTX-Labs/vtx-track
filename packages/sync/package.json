{
  "name": "@vtx-track/sync",
  "version": "0.1.0",
  "description": "Optional self-hosted, end-to-end-encrypted sync for vtx-track — merge your timeline across machines without a third-party cloud.",
  "keywords": ["vtx-track", "vtx-labs", "sync", "self-hosted", "e2ee"],
  "homepage": "https://github.com/VTX-Labs/vtx-track/tree/main/packages/sync#readme",
  "bugs": "https://github.com/VTX-Labs/vtx-track/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VTX-Labs/vtx-track.git",
    "directory": "packages/sync"
  },
  "license": "MIT",
  "author": "VTX Labs (https://vtxlabs.dev)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "vtx-track-sync-server": "dist/server-main.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
