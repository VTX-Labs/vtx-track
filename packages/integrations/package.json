{
  "name": "@vtx-track/integrations",
  "version": "0.1.0",
  "description": "Export/import adapters for vtx-track: WakaTime, Toggl, Clockify, CSV, JSON, and git attribution. Pure, local-first transforms with zero network calls.",
  "keywords": [
    "vtx-track",
    "vtx-labs",
    "time-tracking",
    "wakatime",
    "toggl",
    "clockify",
    "csv",
    "export"
  ],
  "homepage": "https://github.com/VTX-Labs/vtx-track/tree/main/packages/integrations#readme",
  "bugs": "https://github.com/VTX-Labs/vtx-track/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VTX-Labs/vtx-track.git",
    "directory": "packages/integrations"
  },
  "license": "MIT",
  "author": "VTX Labs (https://vtxlabs.dev)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vtx-track/core": "workspace:*",
    "@vtx-track/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.6.5"
}
