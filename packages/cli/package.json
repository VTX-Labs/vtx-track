{
  "name": "@vtx-track/cli",
  "version": "0.1.0",
  "description": "The vtx-track command line: start the tracker, see today/this-week, per-project and per-language time, standups, timesheets, and export — all local.",
  "keywords": ["vtx-track", "vtx-labs", "time-tracking", "cli", "local-first"],
  "homepage": "https://github.com/VTX-Labs/vtx-track/tree/main/packages/cli#readme",
  "bugs": "https://github.com/VTX-Labs/vtx-track/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VTX-Labs/vtx-track.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "VTX Labs (https://vtxlabs.dev)",
  "type": "module",
  "bin": {
    "vtx-track": "dist/cli.js",
    "vtt": "dist/cli.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vtx-track/core": "workspace:*",
    "@vtx-track/protocol": "workspace:*",
    "@vtx-track/service": "workspace:*",
    "@vtx-track/tray": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsup": "^8.3.5",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.6.5"
}
