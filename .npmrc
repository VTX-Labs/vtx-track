# better-sqlite3 and the @paymoapp native addons ship prebuilt binaries; allow
# their install/build scripts to run so the prebuilds are wired up.
enable-pre-post-scripts=true
# Run our trusted workspace-root postinstall (scripts/fetch-native.mjs) even if
# the user's global npmrc sets ignore-scripts=true. The daemon also self-heals
# the SQLite binding at startup, so this is belt-and-suspenders, not the only
# safety net.
ignore-scripts=false
# Don't fail the install if the user's pnpm differs from packageManager — any
# pnpm 10.x works here.
package-manager-strict=false
# Keep the store layout deterministic across machines.
shamefully-hoist=false
