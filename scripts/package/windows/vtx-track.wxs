<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v7 source for the vtx-track Windows installer (MSI).

  Installs the staged, self-contained app (incl. a bundled Node runtime and the
  prebuilt native addons) into the per-user Programs dir, adds its bin\ to the
  user PATH, and registers the background service (a Scheduled Task) on install.
  Per-user (no admin) — matching how VS Code and similar tools install.

  The app tree is harvested automatically with the modern <Files> element, so
  there is no generated fragment to maintain. Built by build-msi.mjs:
    wix build vtx-track.wxs -d Version=X -d StageDir=...\dist-stage\app -arch x64 -o out.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="vtx-track"
    Manufacturer="VTX Labs"
    Version="$(var.Version)"
    UpgradeCode="6F3B2A14-7C9E-4D2A-9E1F-8B7A2C4D5E60"
    Scope="perUser"
    Compressed="yes">

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of vtx-track is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="vtx-track">
          <Directory Id="AppRoot" Name="app" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="vtx-track" Level="1">
      <!-- Harvest the entire staged app tree into AppRoot. -->
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="PathEntry" />
      <ComponentRef Id="ServiceState" />
    </Feature>

    <ComponentGroup Id="AppFiles" Directory="AppRoot">
      <Files Include="$(var.StageDir)\**" />
    </ComponentGroup>

    <!-- Add app\bin to the user PATH so `vtx-track` works in a new shell. -->
    <Component Id="PathEntry" Directory="AppRoot" Guid="A1B2C3D4-1111-2222-3333-444455556666">
      <Environment
        Id="UpdatePath"
        Name="PATH"
        Value="[AppRoot]bin"
        Permanent="no"
        Part="last"
        Action="set"
        System="no" />
      <RegistryValue
        Root="HKCU"
        Key="Software\VTX Labs\vtx-track"
        Name="installed"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>

    <Component Id="ServiceState" Directory="AppRoot" Guid="B2C3D4E5-2222-3333-4444-555566667777">
      <RegistryValue
        Root="HKCU"
        Key="Software\VTX Labs\vtx-track"
        Name="serviceRegistered"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>

    <!-- Register/start on install; stop/remove on uninstall. The service is a
         per-user Scheduled Task created by the CLI, so no admin is needed. -->
    <CustomAction
      Id="InstallService"
      Directory="AppRoot"
      ExeCommand="&quot;[AppRoot]bin\vtx-track.cmd&quot; start"
      Execute="deferred"
      Return="ignore"
      Impersonate="yes" />
    <CustomAction
      Id="UninstallService"
      Directory="AppRoot"
      ExeCommand="&quot;[AppRoot]bin\vtx-track.cmd&quot; uninstall"
      Execute="deferred"
      Return="ignore"
      Impersonate="yes" />

    <InstallExecuteSequence>
      <Custom Action="InstallService" After="InstallFiles" Condition="NOT Installed" />
      <Custom Action="UninstallService" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
