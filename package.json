{
  "name": "vtx-track",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first, privacy-first time tracker for your whole machine — with deep VS Code granularity. Headless daemon, not Electron.",
  "type": "module",
  "license": "MIT",
  "author": "VTX Labs (https://vtxlabs.dev)",
  "homepage": "https://github.com/VTX-Labs/vtx-track#readme",
  "bugs": "https://github.com/VTX-Labs/vtx-track/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VTX-Labs/vtx-track.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/fetch-native.mjs",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "dev": "pnpm --filter @vtx-track/cli dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "clean": "pnpm -r exec rimraf dist coverage"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  },
  "packageManager": "pnpm@10.6.5"
}
